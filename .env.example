# --- Formulario de inscripción: envío de correo (Nodemailer/SMTP) ---
# Correo al que llegan las solicitudes de inscripción
CONTACT_EMAIL=basededatosbefac@gmail.com

# SMTP de Gmail (envío de la cuenta BEFAC)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Cuenta Gmail que envía los correos (debe ser una cuenta real, no la app password)
SMTP_USER=tu.cuenta.befac@gmail.com
# App Password de 16 caracteres generada desde https://myaccount.google.com/apppasswords
SMTP_PASS=xxxx xxxx xxxx xxxx